  "components": {
    "schemas": {
      "MenuLink": {
        "description": "Represents a link in the menu.\n\nParameters:\n    name (str): The name of the menu link.\n    link (str | None): The URL or path the menu link points to.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "link": {
            "title": "Link",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "MenuLink",
        "type": "object"
      },
